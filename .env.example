# =============================================================================
# Sentinel AML Copilot — environment template
#
# Copy to `.env` and fill in real values.  `.env` is gitignored and must never
# be committed.  In CI, every key below lives in GitHub Actions Secrets.
#
# Read in exactly one place: src/sentinel/config/settings.py
# =============================================================================

# --- Runtime ------------------------------------------------------------------
APP_ENV=local                      # local | ci | cloud
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                     # true in CI/cloud, false locally (human-readable)

# --- Neon Postgres — system of record ----------------------------------------
# Neon console -> your project -> Connection string -> "Pooled connection".
# Keep `?sslmode=require`; Neon rejects plaintext connections.
DATABASE_URL=postgresql://user:password@ep-example-123456.ap-southeast-1.aws.neon.tech/sentinel?sslmode=require

# --- Neo4j AuraDB — fund-flow graph ------------------------------------------
# Do NOT fill these in by hand. Download the credentials file Aura offers at
# instance creation and import it verbatim:
#
#     python scripts/import_aura_credentials.py path/to/Neo4j-<id>-Created-<date>.txt
#
# NEO4J_USER and NEO4J_DATABASE are the *instance id*, not "neo4j" — verified
# against a live Aura instance. Setting them to "neo4j" returns Unauthorized.
# The password is shown once at creation; after that you can only reset it.
NEO4J_URI=neo4j+s://abcd1234.databases.neo4j.io
NEO4J_USER=abcd1234
NEO4J_PASSWORD=replace-me
NEO4J_DATABASE=abcd1234

# --- Qdrant Cloud — vector store ---------------------------------------------
# Qdrant Cloud -> Clusters -> your cluster -> API keys.
QDRANT_URL=https://abcd1234-5678-90ef-ghij-klmnopqrstuv.ap-south-1.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=replace-me

# --- Upstash Redis — real-time velocity counters -----------------------------
# Upstash console -> your database -> Connect -> "redis-cli" tab gives the
# rediss:// URL (note the double s — TLS).
REDIS_URL=rediss://default:replace-me@apn1-example-12345.upstash.io:6379

# --- OpenRouter — LLM gateway ------------------------------------------------
# openrouter.ai -> Keys.  Slugs come from openrouter.ai/models and are NOT the
# same strings as a provider's native model IDs.
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-pro        # planning + reasoning nodes
LLM_MODEL_CHEAP=deepseek/deepseek-v4-flash # narration + development iteration
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60

# --- Agent guardrails (enforced in code, not in prompts) ---------------------
AGENT_MAX_TOOL_CALLS=10            # hard cap; the router refuses call 11
AGENT_MIN_CONFIDENCE=0.70          # below this -> human gate
AGENT_HIGH_RISK_SCORE=80           # at or above -> human gate
AGENT_AMOUNT_THRESHOLD_INR=1000000 # Rs 10 lakh at risk -> human gate

# --- Graph projection --------------------------------------------------------
# Drop to 2 if AuraDB Free's real element cap is tighter than the design assumed.
GRAPH_PROJECTION_RADIUS=3

# --- Lakehouse paths ---------------------------------------------------------
# Swap the two Parquet paths to s3://bucket/... to run on a real data lake.
DATA_RAW_PATH=data/raw
DATA_CURATED_PATH=data/curated
DATA_SEED_PATH=data/seed
DUCKDB_PATH=data/sentinel.duckdb

# --- Synthetic data generation ----------------------------------------------
GENERATOR_SEED=20260803            # fixed seed -> reproducible dataset
GENERATOR_CUSTOMERS=5000
GENERATOR_DAYS=90

# --- PII handling ------------------------------------------------------------
# Salt for hashing PAN-style identifiers. Rotate per environment; never reuse
# the example value. PANs are stored as salted SHA-256 only, never plaintext.
PAN_HASH_SALT=replace-with-a-long-random-string

# --- UI ----------------------------------------------------------------------
# The Streamlit console reaches data ONLY through this API base URL.
API_BASE_URL=http://localhost:8000
