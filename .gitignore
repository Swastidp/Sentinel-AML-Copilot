# --- Project-private material (not for publication) ---
docs/
*.pdf
image.png

# --- Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
# Neo4j Aura hands you a credentials .txt at instance creation, and it lands in whatever
# directory the browser downloads to. It contains a working password in plaintext.
Neo4j-*.txt
*credentials*.txt
*.credentials

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
build/
dist/

# --- Tooling caches ---
# fastembed downloads a ~66 MB ONNX model here (path set in config/settings.py, deliberately
# project-local so Windows temp cleanup cannot force a re-download). It is a cache, not source.
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
htmlcov/
.coverage
.coverage.*

# --- Data lakehouse (regenerated by the pipeline; never committed) ---
# data/seed/ IS tracked — hand-authored policy corpus and case narratives
data/raw/
data/curated/
data/*.duckdb
data/*.duckdb.wal

# --- Generated artefacts ---
reports/*.xlsx
artifacts/
*.log

# --- LangGraph checkpoints ---
*.sqlite
*.sqlite3
checkpoints/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
